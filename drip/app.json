{
  "expo": {
    "name": "Drip",
    "slug": "drip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drip",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080b16",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anartic07.drip",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080b16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080b16",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Drip uses your photos to save Drip cards you create.",
          "savePhotosPermission": "Drip saves Drip cards to your photo library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13de2ccc-c64c-4846-ab0b-cb14d89d358c"
      }
    }
  }
}
